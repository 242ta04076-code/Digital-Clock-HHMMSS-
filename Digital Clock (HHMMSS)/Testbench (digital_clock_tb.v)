`timescale 1ns/1ps

module digital_clock_tb;

reg clk;
reg reset;

wire [5:0] sec;
wire [5:0] min;
wire [4:0] hour;

digital_clock uut(
    .clk(clk),
    .reset(reset),
    .sec(sec),
    .min(min),
    .hour(hour)
);

always #5 clk = ~clk;

initial
begin
    clk = 0;
    reset = 1;

    #10;
    reset = 0;

    #700;

    $finish;
end

initial
begin
    $display("Time(HH:MM:SS)");

    $monitor("%02d:%02d:%02d",
              hour,min,sec);
end

endmodule